\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Reconstructed observed (left panel) and astrophysical (right panel) binary black hole population in log10 of component masses $m_1$ and $m_2$ using the hierarchical DPGMM implementation in FIGARO inferred from simulated population of gravitational-wave signals mimicking observing run O4. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panels show the corresponding two-dimensional joint distributions. The observed population is biased towards higher masses due to selection effects, while the astrophysical population is corrected for these effects and represents the true underlying distribution of binary black hole mergers, extending to higher redshifts and lower masses that are relevant to strong gravitational-wave lensing, which occurs for binaries at high redshift. }}{19}{figure.5}\protected@file@percent }
\newlabel{fig:reconstructed_population_log}{{5}{19}{Reconstructed observed (left panel) and astrophysical (right panel) binary black hole population in log10 of component masses $m_1$ and $m_2$ using the hierarchical DPGMM implementation in FIGARO inferred from simulated population of gravitational-wave signals mimicking observing run O4. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panels show the corresponding two-dimensional joint distributions. The observed population is biased towards higher masses due to selection effects, while the astrophysical population is corrected for these effects and represents the true underlying distribution of binary black hole mergers, extending to higher redshifts and lower masses that are relevant to strong gravitational-wave lensing, which occurs for binaries at high redshift}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Reconstructed strongly lensed binary black hole population for 2-image systems using FIGARO's DPGMM. The reconstruction is performed on the joint distribution of the logarithmic relative effective luminosity distance $\log _{10}(d_{L,2}^{\mathrm  {eff}}/d_{L,1}^{\mathrm  {eff}})$ and logarithmic arrival-time delay $\log _{10}(\Delta t_2/\mathrm  {s})$, with the earliest-arriving image taken as the reference. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panel shows the corresponding two-dimensional joint distribution. The reconstructed density reproduces the main features of the simulated lensing-parameter distribution.}}{20}{figure.6}\protected@file@percent }
\newlabel{fig:lensed_population_l2}{{6}{20}{Reconstructed strongly lensed binary black hole population for 2-image systems using FIGARO's DPGMM. The reconstruction is performed on the joint distribution of the logarithmic relative effective luminosity distance $\log _{10}(d_{L,2}^{\mathrm {eff}}/d_{L,1}^{\mathrm {eff}})$ and logarithmic arrival-time delay $\log _{10}(\Delta t_2/\mathrm {s})$, with the earliest-arriving image taken as the reference. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panel shows the corresponding two-dimensional joint distribution. The reconstructed density reproduces the main features of the simulated lensing-parameter distribution}{figure.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A}$H_2$: catalogued lens without resolved strong lensing EM images}{20}{section.1.A}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Reconstructed strongly lensed binary black hole population for 3-image systems using FIGARO's DPGMM. The reconstruction is performed on the joint four-dimensional distribution of logarithmic relative effective luminosity distances $\log _{10}(d_{L,j}^{\mathrm  {eff}}/d_{L,1}^ {\mathrm  {eff}})$ and logarithmic arrival-time delays $\log _{10}(\Delta t_j/\mathrm  {s})$, where $j=2,3$. The images are ordered by arrival time, with the earliest-arriving image taken as the reference. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panels show the corresponding two-dimensional joint distributions. The reconstructed density captures the main features and correlations of the simulated lensing parameters.}}{21}{figure.7}\protected@file@percent }
\newlabel{fig:lensed_population_l3}{{7}{21}{Reconstructed strongly lensed binary black hole population for 3-image systems using FIGARO's DPGMM. The reconstruction is performed on the joint four-dimensional distribution of logarithmic relative effective luminosity distances $\log _{10}(d_{L,j}^{\mathrm {eff}}/d_{L,1}^ {\mathrm {eff}})$ and logarithmic arrival-time delays $\log _{10}(\Delta t_j/\mathrm {s})$, where $j=2,3$. The images are ordered by arrival time, with the earliest-arriving image taken as the reference. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panels show the corresponding two-dimensional joint distributions. The reconstructed density captures the main features and correlations of the simulated lensing parameters}{figure.7}{}}
\newlabel{H2evidence}{{A3}{21}{$H_2$: catalogued lens without resolved strong lensing EM images}{equation.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Reconstructed strongly lensed binary black hole population for 4-image systems using FIGARO's DPGMM. The reconstruction is performed on the joint six-dimensional distribution of logarithmic relative effective luminosity distances $\log _{10}(d_{L,j}^{\mathrm  {eff}}/d_{L,1}^ {\mathrm  {eff}})$ and logarithmic arrival-time delays $\log _{10}(\Delta t_j/\mathrm  {s})$, where $j=2,3,4$. The images are ordered by arrival time, with the earliest-arriving image taken as the reference. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panels show the corresponding two-dimensional joint distributions. The reconstructed density captures the main features and correlations of the simulated lensing parameters.}}{22}{figure.8}\protected@file@percent }
\newlabel{fig:lensed_population_l4}{{8}{22}{Reconstructed strongly lensed binary black hole population for 4-image systems using FIGARO's DPGMM. The reconstruction is performed on the joint six-dimensional distribution of logarithmic relative effective luminosity distances $\log _{10}(d_{L,j}^{\mathrm {eff}}/d_{L,1}^ {\mathrm {eff}})$ and logarithmic arrival-time delays $\log _{10}(\Delta t_j/\mathrm {s})$, where $j=2,3,4$. The images are ordered by arrival time, with the earliest-arriving image taken as the reference. The diagonal panels show the one-dimensional marginal distributions, while the off-diagonal panels show the corresponding two-dimensional joint distributions. The reconstructed density captures the main features and correlations of the simulated lensing parameters}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Distributions of the logarithmic Bayes factors $\log _{10}B_U^L$ (upper panel) and posterior odds $\log _{10}O_U^L$ (lower panel) for simulated strongly lensed 2-image (blue), 3-image (orange), and 4-image (green) systems. The dashed vertical lines indicate the corresponding distribution peaks. The Bayes factor distributions shift towards larger values with increasing image multiplicity, reflecting the additional information provided by multiple lensed images. After incorporating the prior odds, the posterior odds distributions shift towards lower values due to the low astrophysical probability of strong lensing.}}{23}{figure.9}\protected@file@percent }
\newlabel{fig:log_bayes_factor_posterior_odds_gw}{{9}{23}{Distributions of the logarithmic Bayes factors $\log _{10}B_U^L$ (upper panel) and posterior odds $\log _{10}O_U^L$ (lower panel) for simulated strongly lensed 2-image (blue), 3-image (orange), and 4-image (green) systems. The dashed vertical lines indicate the corresponding distribution peaks. The Bayes factor distributions shift towards larger values with increasing image multiplicity, reflecting the additional information provided by multiple lensed images. After incorporating the prior odds, the posterior odds distributions shift towards lower values due to the low astrophysical probability of strong lensing}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces }}{24}{figure.10}\protected@file@percent }
\newlabel{fig:bayes_factor_comparison}{{10}{24}{}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Logarithmic Bayes factors $\log _{10}B_U^L$ as functions of component masses $m_1$ (left panel) and $m_2$ (right panel) for simulated strongly lensed 2-image (blue), 3-image (orange), and 4-image (green) systems. The Bayes factors are generally larger for systems with higher image multiplicities, with the highest values predominantly occurring at lower component masses. The distributions show considerable scatter and overlap between image multiplicities. Values at $\log _{10}B_U^L=-30$ correspond to the imposed numerical cutoff, including systems failing the preliminary posterior-overlap checks.}}{24}{figure.11}\protected@file@percent }
\newlabel{fig:scatter_log_bayes_factor_masses_gw}{{11}{24}{Logarithmic Bayes factors $\log _{10}B_U^L$ as functions of component masses $m_1$ (left panel) and $m_2$ (right panel) for simulated strongly lensed 2-image (blue), 3-image (orange), and 4-image (green) systems. The Bayes factors are generally larger for systems with higher image multiplicities, with the highest values predominantly occurring at lower component masses. The distributions show considerable scatter and overlap between image multiplicities. Values at $\log _{10}B_U^L=-30$ correspond to the imposed numerical cutoff, including systems failing the preliminary posterior-overlap checks}{figure.11}{}}
